# Copy to .env and replace the empty secret with: openssl rand -hex 32
# Keep this secret stable across restarts and updates. Never commit .env.
DJANGO_SECRET_KEY=
# Default release version. Release downloads pin their own version.
WISHLIST_VERSION=0.1.2
WISHLIST_BIND_ADDRESS=127.0.0.1
# For trusted LAN access, add the exact server hostname/IP (no scheme or port).
DJANGO_ALLOWED_HOSTS=
# Normally empty for same-origin access; do not add wildcard origins.
DJANGO_CSRF_TRUSTED_ORIGINS=
